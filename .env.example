# Copy to .env and fill in. See BACKEND_RUN_GUIDE.md for details.

# --- Required ---------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
SUPABASE_URL=https://your-project.supabase.co

# Supabase Settings -> API -> Project API keys -> anon/public.
# This key is safe to expose (the frontend ships it too); Row Level Security is
# what protects the data. See supabase/README.md.
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Optional ---------------------------------------------------------------
# Gemini model id.
GEMINI_MODEL=gemini-2.5-flash-lite

# Comma-separated list of allowed frontend origins. No trailing slashes.
CORS_ORIGINS=http://localhost:5173,https://codequest101.vercel.app

# Requests a guest may make before being asked to sign up.
GUEST_RATE_LIMIT=10

# Per-IP overrides as a JSON object. -1 means unlimited.
# RATE_LIMIT_RULES={"203.0.113.4": 100, "203.0.113.5": -1}
RATE_LIMIT_RULES={}

# Number of reverse proxies in front of the app. Render puts exactly one there.
# Used to pick the real client IP out of X-Forwarded-For.
TRUSTED_PROXY_HOPS=1

# DEBUG logs full prompts and message content — avoid it in production.
LOG_LEVEL=INFO

# Leave empty to log to stdout only. The container filesystem is ephemeral.
APP_LOG_FILE=
